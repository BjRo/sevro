diff --git a/evals/domain/user-skill-state-eval-checks.test.ts b/evals/domain/user-skill-state-eval-checks.test.ts
new file mode 100644
index 00000000..6044f7cd
--- /dev/null
+++ b/evals/domain/user-skill-state-eval-checks.test.ts
@@ -0,0 +1,71 @@
+import { afterEach, expect, test } from "bun:test";
+import { mkdtemp, mkdir, readFile, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join, resolve } from "node:path";
+import { spawnSync } from "node:child_process";
+import { parse as parseYaml } from "yaml";
+
+const roots: string[] = [];
+afterEach(async () => {
+  await Promise.all(
+    roots.splice(0).map((root) => rm(root, { recursive: true, force: true })),
+  );
+});
+
+type OracleCase = { checks: { name: string; run?: string }[] };
+
+async function absenceCheck() {
+  const value = parseYaml(
+    await readFile(
+      resolve(
+        import.meta.dir,
+        "../../plugins/foundation/darrow-skill-authoring/skills/create-agent-skill/evals/refuse-undefined-skill.yaml",
+      ),
+      "utf8",
+    ),
+  ) as OracleCase;
+  const check = value.checks.find(
+    (check) =>
+      check.name === "undefined capability creates no user-level skill",
+  );
+  if (!check?.run) throw new Error("user-skill absence check is unavailable");
+  return check.run;
+}
+
+test.each([
+  "none",
+  "codex",
+  "agent",
+  "command_agent",
+  "command_codex",
+  "missing",
+])("user-skill absence oracle observes %s candidate state", async (mode) => {
+  const root = await mkdtemp(join(tmpdir(), "darrow-user-skills-"));
+  roots.push(root);
+  const locations = ["codex", "agent", "command_agent", "command_codex"];
+  const environment: Record<string, string> = { PATH: "/usr/bin:/bin" };
+  for (const name of locations) {
+    const path = join(root, name);
+    if (mode !== "missing" || name !== "agent") await mkdir(path);
+    environment[`SEVRO_CANDIDATE_ARTIFACT_${name.toUpperCase()}_SKILLS`] = path;
+    if (mode === name) {
+      await mkdir(join(path, "created"));
+      await writeFile(join(path, "created/SKILL.md"), "user skill");
+    }
+  }
+  await mkdir(join(root, "codex/.system/bundled"), { recursive: true });
+  await writeFile(
+    join(root, "codex/.system/bundled/SKILL.md"),
+    "bundled skill",
+  );
+  const result = spawnSync("/bin/bash", ["-c", await absenceCheck()], {
+    cwd: root,
+    env: environment,
+    encoding: "utf8",
+  });
+  expect(result.error).toBeUndefined();
+  expect(result.status).toBe(mode === "missing" ? 2 : 0);
+  if (mode === "none") expect(result.stdout).toBe("");
+  else if (mode !== "missing")
+    expect(result.stdout).toContain(`${mode}/created/SKILL.md`);
+});
