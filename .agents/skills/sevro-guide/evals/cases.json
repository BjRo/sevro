[
  {
    "id": "orientation",
    "prompt": "What is Sevro, and how can I get my first successful result?",
    "checks": [
      {
        "id": "answer.purpose",
        "grader": "sevro.regex",
        "configuration": {
          "pattern": "evaluat|benchmark",
          "flags": "i"
        }
      },
      {
        "id": "answer.first-success",
        "grader": "sevro.regex",
        "configuration": {
          "pattern": "getting-started|deterministic",
          "flags": "i"
        }
      },
      {
        "id": "answer.citation",
        "grader": "sevro.regex",
        "configuration": {
          "pattern": "(?:README\\.md|docs\\/[a-z0-9_./-]+\\.md|package\\.json|LICENSE)"
        }
      }
    ],
    "extensionData": {
      "sevro.guide.activation": true,
      "sevro.guide.inspect-citation": true
    }
  },
  {
    "id": "explicit",
    "prompt": "{{sevro.skill_invocation}} Explain execution, grading, and task verdicts.",
    "checks": [
      {
        "id": "answer.states",
        "grader": "sevro.regex",
        "configuration": {
          "pattern": "not_assessed|not.assessed|grading",
          "flags": "i"
        }
      },
      {
        "id": "answer.not-assessed",
        "grader": "sevro.regex",
        "configuration": {
          "pattern": "not_assessed"
        }
      },
      {
        "id": "answer.not-requested",
        "grader": "sevro.regex",
        "configuration": {
          "pattern": "not_requested"
        }
      },
      {
        "id": "answer.passed",
        "grader": "sevro.regex",
        "configuration": {
          "pattern": "passed|passing",
          "flags": "i"
        }
      },
      {
        "id": "answer.no-grading-passed",
        "grader": "sevro.regex",
        "configuration": {
          "pattern": "grading\\s+(?:is|=)\\s*[\"'\\x60]*passed",
          "flags": "i",
          "negate": true
        }
      },
      {
        "id": "answer.citation",
        "grader": "sevro.regex",
        "configuration": {
          "pattern": "(?:README\\.md|docs\\/[a-z0-9_./-]+\\.md|package\\.json|LICENSE)"
        }
      }
    ],
    "extensionData": {
      "sevro.guide.activation": true,
      "sevro.guide.explicit": true,
      "sevro.guide.inspect-citation": true
    }
  },
  {
    "id": "unrelated",
    "prompt": "What is 17 multiplied by 19?",
    "checks": [
      {
        "id": "answer.arithmetic",
        "grader": "sevro.regex",
        "configuration": {
          "pattern": "323"
        }
      }
    ],
    "extensionData": {
      "sevro.guide.activation": false
    }
  },
  {
    "id": "missing",
    "prompt": "Explain the tutorial in docs/getting-started.md. What exact command does it prescribe?",
    "checks": [
      {
        "id": "answer.unknown",
        "grader": "sevro.regex",
        "configuration": {
          "pattern": "missing|unknown|unavailable|doesn't exist|does not exist|not (?:present|found|available)|cannot (?:read|find)",
          "flags": "i"
        }
      }
    ],
    "extensionData": {
      "sevro.guide.activation": true,
      "sevro.guide.fixture": "missing"
    }
  },
  {
    "id": "conflict",
    "prompt": "README.md and package.json disagree about the package name. Which name should I install?",
    "checks": [
      {
        "id": "answer.conflict",
        "grader": "sevro.regex",
        "configuration": {
          "pattern": "conflict|disagree|inconsisten|contradict",
          "flags": "i"
        }
      },
      {
        "id": "answer.no-invented-cause",
        "grader": "sevro.regex",
        "configuration": {
          "pattern": "(?:looks? like|probably|must be|is a)\\s+(?:a\\s+)?(?:placeholder|stale)",
          "flags": "i",
          "negate": true
        }
      },
      {
        "id": "answer.both-sources",
        "grader": "sevro.regex",
        "configuration": {
          "pattern": "README\\.md[\\s\\S]*package\\.json|package\\.json[\\s\\S]*README\\.md"
        }
      }
    ],
    "extensionData": {
      "sevro.guide.activation": true,
      "sevro.guide.fixture": "conflict",
      "sevro.guide.inspect-citation": true,
      "sevro.guide.inspect-sources": ["README.md", "package.json"]
    }
  },
  {
    "id": "stale",
    "prompt": "docs/legacy-validation.md says Linux was fully verified. Does that establish current Linux support?",
    "checks": [
      {
        "id": "answer.unverified",
        "grader": "sevro.regex",
        "configuration": {
          "pattern": "unverified|not verified|does not establish|doesn't establish|not.*support",
          "flags": "i"
        }
      },
      {
        "id": "answer.linux",
        "grader": "sevro.regex",
        "configuration": {
          "pattern": "Linux",
          "flags": "i"
        }
      },
      {
        "id": "answer.no-expanded-support",
        "grader": "sevro.regex",
        "configuration": {
          "pattern": "Linux support is not unverified|Linux is (?:fully )?(?:supported|verified)",
          "flags": "i",
          "negate": true
        }
      },
      {
        "id": "answer.citation",
        "grader": "sevro.regex",
        "configuration": {
          "pattern": "(?:README\\.md|docs\\/[a-z0-9_./-]+\\.md|package\\.json|LICENSE)"
        }
      }
    ],
    "extensionData": {
      "sevro.guide.activation": true,
      "sevro.guide.fixture": "stale",
      "sevro.guide.inspect-citation": true
    }
  },
