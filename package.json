{
  "name": "@bjoernrochel/sevro",
  "version": "0.1.0-rc.2",
  "license": "SEE LICENSE IN LICENSE",
  "description": "A standalone evaluation runner for agentic coding capabilities",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BjRo/sevro.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "latest"
  },
  "packageManager": "bun@1.3.13",
  "files": [
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "docs/",
    "examples/",
    "schemas/",
    "src/"
  ],
  "bin": {
    "sevro": "./src/cli.ts"
  },
  "scripts": {
    "cli:dev": "bun src/cli.ts",
    "test": "bun test",
    "schemas:generate": "bun scripts/generate-schemas.ts",
    "schemas:check": "bun scripts/generate-schemas.ts --check",
    "test:package-install": "bun scripts/verify-package-install.ts",
    "check:docs": "bun scripts/check-docs.ts",
    "check:docs:external": "bun scripts/check-docs.ts --external",
    "test:docs-examples": "bun scripts/verify-doc-examples.ts",
    "guide:sync": "bun scripts/sync-guide.ts",
    "eval:guide": "bun scripts/eval-guide.ts",
    "release:prepare": "bun scripts/prepare-release.ts",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check README.md CONTRIBUTING.md AGENTS.md CLAUDE.md 'docs/**/*.md' '.agents/**/*.md' '.agents/**/*.json' '.claude/**/*.md' examples/**/*.json examples/**/*.ts schemas/*.json src/**/*.ts scripts/**/*.ts tests/**/*.ts package.json tsconfig.json .github/workflows/*.yml"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "smol-toml": "1.8.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/markdown-it": "14.1.2",
    "@types/shell-quote": "1.7.5",
    "github-slugger": "2.0.0",
    "markdown-it": "14.2.0",
    "prettier": "^3.9.9",
    "shell-quote": "1.12.0"
  }
}
