{
  "name": "@bjoernrochel/sevro",
  "version": "0.1.0-rc.2",
  "license": "BUSL-1.1",
  "description": "A standalone evaluation runner for agentic coding capabilities",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BjRo/sevro.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "latest"
  },
  "packageManager": "bun@1.3.13",
  "files": [
    "README.md",
    "docs/",
    "examples/",
    "schemas/",
    "src/"
  ],
  "bin": {
    "sevro": "./src/cli.ts"
  },
  "scripts": {
    "check:typescript": "bun scripts/check-typescript.mjs",
    "check:typescript:fast": "bun run check:typescript --fast",
    "lint": "eslint . --max-warnings 0",
    "cli:dev": "bun src/cli.ts",
    "test": "bun test",
    "schemas:generate": "bun scripts/generate-schemas.ts",
    "schemas:check": "bun scripts/generate-schemas.ts --check",
    "test:package-install": "bun scripts/verify-package-install.ts",
    "release:prepare": "bun scripts/prepare-release.ts",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check README.md docs/*.md examples/**/*.json examples/**/*.ts schemas/*.json src/**/*.ts scripts/**/*.ts scripts/**/*.mjs scripts/**/*.cjs tests/**/*.ts eslint.config.mjs package.json tsconfig.json typescript-sources.json .github/workflows/*.yml"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "smol-toml": "1.8.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@babel/core": "8.0.6",
    "@babel/plugin-transform-typescript": "8.0.6",
    "@eslint/js": "10.0.1",
    "@types/bun": "1.3.13",
    "@types/istanbul-lib-coverage": "2.0.6",
    "@types/istanbul-lib-instrument": "1.7.8",
    "@types/istanbul-lib-report": "3.0.3",
    "@types/istanbul-reports": "3.0.4",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-instrument": "6.0.3",
    "istanbul-lib-report": "3.0.1",
    "istanbul-lib-source-maps": "5.0.6",
    "istanbul-reports": "3.2.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "8.71.1"
  }
}
