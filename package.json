{
  "name": "@bjoernrochel/sevro",
  "version": "1.1.2",
  "license": "SEE LICENSE IN LICENSE",
  "description": "A standalone evaluation runner for agentic coding capabilities",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BjRo/sevro.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "latest"
  },
  "packageManager": "bun@1.3.13",
  "files": [
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "docs/*.md",
    "!docs/*-validation.md",
    "!docs/engine-slice.md",
    "!docs/evidence.md",
    "!docs/usability-study.md",
    "docs/assets/README.md",
    "docs/licenses/",
    "docs/specs/",
    "examples/",
    "schemas/",
    "src/",
    "dist/"
  ],
  "bin": {
    "sevro": "./dist/src/cli.js"
  },
  "scripts": {
    "check:typescript": "bun scripts/check-typescript.ts",
    "check:typescript:fast": "bun run check:typescript --fast",
    "lint": "eslint . --max-warnings 0",
    "cli:dev": "bun src/cli.ts",
    "test": "bun test",
    "schemas:generate": "bun scripts/generate-schemas.ts",
    "schemas:check": "bun scripts/generate-schemas.ts --check",
    "test:package-install": "bun scripts/verify-package-install.ts",
    "check:docs": "bun scripts/check-docs.ts",
    "docs:sync": "bun scripts/sync-release-docs.ts",
    "check:docs:external": "bun scripts/check-docs.ts --external",
    "test:docs-examples": "bun scripts/verify-doc-examples.ts",
    "guide:sync": "bun scripts/sync-guide.ts",
    "eval:guide": "bun scripts/eval-guide.ts",
    "release:prepare": "bun run build && bun scripts/prepare-release.ts",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check README.md CONTRIBUTING.md AGENTS.md CLAUDE.md 'docs/**/*.md' '.agents/**/*.md' '.agents/**/*.json' '.claude/**/*.md' 'scripts/**/*.md' 'scripts/**/*.json' 'examples/**/*.json' 'examples/**/*.ts' 'schemas/*.json' 'src/**/*.ts' 'scripts/**/*.ts' 'scripts/**/*.cjs' 'tests/**/*.ts' eslint.config.mjs package.json tsconfig.json '.github/workflows/*.yml'",
    "build": "bun scripts/build.ts",
    "prepack": "bun run build",
    "test:runtime-node": "bun scripts/verify-node-runtime.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "smol-toml": "1.8.0",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@babel/core": "8.0.6",
    "@babel/plugin-transform-typescript": "8.0.6",
    "@eslint/js": "10.0.1",
    "@types/bun": "1.3.13",
    "@types/markdown-it": "14.1.2",
    "@types/shell-quote": "1.7.5",
    "@types/istanbul-lib-coverage": "2.0.6",
    "@types/istanbul-lib-instrument": "1.7.8",
    "@types/istanbul-lib-report": "3.0.3",
    "@types/istanbul-reports": "3.0.4",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "github-slugger": "2.0.0",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-instrument": "6.0.3",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "markdown-it": "14.2.0",
    "prettier": "3.9.9",
    "shell-quote": "1.12.0",
    "typescript-eslint": "8.71.1"
  },
  "engines": {
    "node": ">=24.13.0"
  }
}
