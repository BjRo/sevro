{
  "name": "@bjoernrochel/sevro",
  "version": "0.1.0-rc.2",
  "license": "BUSL-1.1",
  "description": "A standalone evaluation runner for agentic coding capabilities",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BjRo/sevro.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "latest"
  },
  "packageManager": "bun@1.3.13",
  "files": [
    "README.md",
    "docs/",
    "examples/",
    "schemas/",
    "src/"
  ],
  "bin": {
    "sevro": "./src/cli.ts"
  },
  "scripts": {
    "cli:dev": "bun src/cli.ts",
    "test": "bun test",
    "schemas:generate": "bun scripts/generate-schemas.ts",
    "schemas:check": "bun scripts/generate-schemas.ts --check",
    "test:package-install": "bun scripts/verify-package-install.ts",
    "release:prepare": "bun scripts/prepare-release.ts",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check README.md docs/*.md examples/**/*.json examples/**/*.ts schemas/*.json src/**/*.ts scripts/**/*.ts tests/**/*.ts package.json tsconfig.json .github/workflows/*.yml"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "smol-toml": "1.8.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "prettier": "^3.9.9"
  }
}
